# Proxy Manager 生产环境配置模板
#
# Docker Compose 部署：cp .env.production.example .env
# 二进制 / systemd 部署：cp .env.production.example /etc/proxy-manager.env，
#   并取消文件末尾“仅二进制 / systemd 部署”段落的注释。
# 本地开发请使用 .env.example。
#
# 三个密钥故意留空：漏填时服务会拒绝启动，避免带着示例值上线。
# 可以用下面的命令一次性生成 SESSION_SECRET 和 MASTER_KEY：
#   sed -i "s|^SESSION_SECRET=.*|SESSION_SECRET=$(openssl rand -hex 32)|; s|^MASTER_KEY=.*|MASTER_KEY=$(openssl rand -base64 32)|" .env
#
# 注释必须单独占一行，不要写在值的后面。

APP_ENV=production
EXECUTOR_MODE=ssh
COOKIE_SECURE=true

# ---- 必填 ----

# 控制台管理员。密码至少 8 位，建议不要使用 $、#、引号和空格。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 会话签名密钥，至少 32 个字符。生成：openssl rand -hex 32
SESSION_SECRET=

# 数据加密主密钥，Base64 编码的 32 字节。生成：openssl rand -base64 32
# 设置后不能修改，并且必须和数据库一起备份；丢失后已保存的 SSH 凭据和代理密码无法解密。
MASTER_KEY=

# ---- 访问来源 ----

# 浏览器访问控制台的完整地址（协议 + 域名 + 端口），多个用逗号分隔，末尾不带斜杠。
# 放在 HTTPS 反向代理后面时填写，例如：CORS_ORIGINS=https://pm.example.com
# 通过 SSH 隧道访问 http://localhost:8080 时可以留空。
CORS_ORIGINS=

# 可信反向代理的 IP 或 CIDR，多个用逗号分隔。
# 只有来自这些地址的 X-Forwarded-For / X-Forwarded-Proto 请求头才会被采信。
# Docker 部署：填 Docker 网络的网关地址，例如 172.18.0.1（查看方法见 README）。
# systemd 部署且反向代理在本机：127.0.0.1/32,::1/128
TRUSTED_PROXY_CIDRS=

# 手机代理客户端访问控制台的地址，用于生成订阅地址，例如：PUBLIC_URL=https://pm.example.com
# 留空时使用浏览器当前访问控制台的地址。通过 SSH 隧道或内网地址管理控制台时必须填写。
PUBLIC_URL=

# ---- 可选调优（以下均为默认值）----

# SESSION_TTL=12h
# WORKER_CONCURRENCY=4
# WORKER_POLL_INTERVAL=300ms
# SSH_TIMEOUT=10s
# COMMAND_TIMEOUT=15m
# TRAFFIC_SYNC_INTERVAL=5m
# TRAFFIC_RECONCILE_INTERVAL=30s

# ---- 仅二进制 / systemd 部署 ----
# Docker 镜像已经内置了这些路径。Docker 部署时不要取消注释，
# 否则会覆盖镜像设置，导致页面 404、数据写不进持久化卷。

# HTTP_ADDR=127.0.0.1:8080
# DB_PATH=/var/lib/proxy-manager/proxy-manager.db
# STATIC_DIR=/opt/proxy-manager/web
# INSTALL_SCRIPT_PATH=/opt/proxy-manager/3proxy-install.sh
