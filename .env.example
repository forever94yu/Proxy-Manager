# Local development template for `npm run dev`. For production deployments
# (Docker or systemd) start from .env.production.example instead: the relative
# paths below would override the paths baked into the Docker image.
#
# Development uses safe local defaults when these values are omitted. Production
# refuses to start until ADMIN_PASSWORD, SESSION_SECRET and MASTER_KEY are set.
APP_ENV=development
HTTP_ADDR=:8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ProxyManager!2026
SESSION_SECRET=replace-with-at-least-32-random-characters
MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
SESSION_TTL=12h

DB_PATH=./data/proxy-manager.db
EXECUTOR_MODE=mock
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL=300ms
SSH_TIMEOUT=10s
COMMAND_TIMEOUT=15m
# Traffic quotas: counter collection and policy reconciliation intervals.
TRAFFIC_SYNC_INTERVAL=5m
TRAFFIC_RECONCILE_INTERVAL=30s
COOKIE_SECURE=false

# Only peers in these CIDRs may supply X-Forwarded-For/X-Forwarded-Proto.
# Example for a sidecar reverse proxy: TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
TRUSTED_PROXY_CIDRS=

# Paths are resolved from the server working directory for local `npm run dev`.
INSTALL_SCRIPT_PATH=../3proxy-install.sh
STATIC_DIR=../web/dist

# Comma-separated origins are only needed when the UI is hosted separately.
CORS_ORIGINS=http://localhost:5173

# Origin proxy clients use to fetch subscriptions, e.g. https://pm.example.com.
# Empty: use the address the browser uses to reach the console.
PUBLIC_URL=
